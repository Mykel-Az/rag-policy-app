# Groq API key (free tier): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model used to generate answers
GROQ_MODEL=openai/gpt-oss-20b

# Separate, larger model used by eval/run_eval.py to judge groundedness
# (kept distinct from GROQ_MODEL to avoid the judge favoring its own answers)
GROQ_JUDGE_MODEL=openai/gpt-oss-120b

# Used by the Streamlit frontend to reach the FastAPI backend
BACKEND_URL=http://localhost:8000